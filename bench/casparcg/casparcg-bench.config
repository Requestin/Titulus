<?xml version="1.0" encoding="utf-8"?>
<!--
  bench/casparcg/casparcg-bench.config

  CasparCG 2.5 config for the Titulus Phase 0 baseline benchmark
  (DEVELOPMENT_PROMPT §11.1: run the SAME bench.html scene through CasparCG's
  HTML Producer on identical hardware to get the fps/drops baseline that
  Titulus bg_engine must meet).

  Setup:
    - 1 channel @ 1080p50 (CPU-only HTML, enable-gpu=false) — CasparCG's
      HTML Producer is the direct analogue of bg_engine + channel.html.
    - ffmpeg consumer to /dev/null (headless, no SDI). The channel still drives
      the producer at 50fps and reports dropped-frame diagnostics.
    - html cache-path per run (avoid process-singleton collisions).
    - AMCP on 127.0.0.1:5250 so we can PLAY the bench scene.

  Run (driver: bench/run-casparcg-baseline.sh):
    bench/run-casparcg-baseline.sh [duration_sec] [graphics_per_channel]
  The script starts the server, AMCP-PLAYs the bench scene, runs for a fixed
  duration, then counts frames in the matroska output via ffprobe to get the
  effective fps and drops.
-->
<configuration>
    <paths>
        <media-path>media/</media-path>
        <log-path>log/</log-path>
        <data-path>data/</data-path>
        <template-path>template/</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <log-level>info</log-level>
    <channels>
        <channel>
            <video-mode>1080p5000</video-mode>
            <consumers>
                <!-- ffmpeg -> matroska file: a real muxer that accepts frames so
                     the consumer initializes and the channel drives its HTML
                     producer at 1080p50. We count frames in the output via
                     ffprobe to get the effective fps and detect drops. CasparCG
                     picks libx264 by default (its args parser only honors a
                     subset of ffmpeg options); encoding rate is stable enough
                     for a producer benchmark. Mirrors Titulus bg_engine's
                     null-consumer bench path. -->
                <ffmpeg>
                    <path>bench-out.mkv</path>
                    <args></args>
                </ffmpeg>
            </consumers>
        </channel>
    </channels>
    <html>
        <enable-gpu>false</enable-gpu>
        <cache-path>/tmp/casparcg-cef-cache</cache-path>
    </html>
    <controllers>
        <tcp>
            <port>5250</port>
            <protocol>AMCP</protocol>
            <address>127.0.0.1</address>
        </tcp>
    </controllers>
</configuration>
