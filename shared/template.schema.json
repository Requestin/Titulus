{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://titulus/titulus/template.schema.json",
  "title": "Titulus Template",
  "description": "Canonical template domain model (DEVELOPMENT_PROMPT §6.2). Validated by backend /api/templates/validate (ajv). AI-friendly: a conforming JSON renders deterministically through runtime/domRenderer.",
  "type": "object",
  "required": ["id", "name", "canvas", "variables", "groups", "layers", "rootStack", "groupStacks", "timeline"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Template schema version for migrations (e.g. 1.0.0).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": { "type": "string", "description": "UUID" },
    "name": { "type": "string" },
    "description": {
      "type": "string",
      "description": "Human-readable intent; useful for operators and AI generation."
    },
    "tags": {
      "type": "array",
      "description": "Search/generation tags (e.g. lower-third, election, breaking).",
      "items": { "type": "string" },
      "maxItems": 32
    },
    "metadata": { "$ref": "#/$defs/templateMetadata" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "control.layer-id-on-air",
          "crawl.layer",
          "data.expanded-variable-types",
          "data.media-token-resolution",
          "data.select-map-policies",
          "data.sources-formats",
          "data.time-expressions",
            "properties.position-z",
          "rectangle.four-corner-gradient",
          "text.shadow",
          "text.transform",
          "timeline.action-cues-items",
          "timeline.action-from-end",
          "timeline.continue-wait",
          "timeline.object-track-groups",
          "timeline.protected-update-flow"
        ]
      },
      "uniqueItems": true
    },
    "layerId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "description": "'transparent' or a CSS color" }
      }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" }
    },
    "rootStack": {
      "type": "array",
      "description": "Top-level z-order; last entry = frontmost.",
      "items": { "$ref": "#/$defs/stackEntry" }
    },
    "groupStacks": {
      "type": "object",
      "description": "Per-group child ordering (groupId -> entries).",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/stackEntry" }
      }
    },
    "timeline": { "$ref": "#/$defs/timeline" },
    "data": { "$ref": "#/$defs/templateData" }
  },

  "$defs": {
    "templateMetadata": {
      "type": "object",
      "description": "Optional AI/operator hints. Runtime may ignore these fields.",
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string" },
        "locale": { "type": "string", "description": "BCP-47 locale, e.g. en-US" },
        "safeTitle": { "type": "string", "description": "One-line title for generated catalogs." },
        "notes": { "type": "string" }
      }
    },
    "blendMode": {
      "type": "string",
      "enum": ["normal", "multiply", "screen", "add", "overlay", "darken", "lighten"]
    },
    "easingType": {
      "type": "string",
      "enum": ["linear", "power2.in", "power2.out", "power2.inOut", "bounce.out", "elastic.out"]
    },
    "variableBinding": {
      "type": "object",
      "required": ["type", "variableId"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "variable" },
        "variableId": { "type": "string" }
      }
    },
    "stringOrBinding": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/variableBinding" }
      ]
    },
    "numberOrBinding": {
      "oneOf": [
        { "type": "number" },
        { "$ref": "#/$defs/variableBinding" }
      ]
    },
    "transform": {
      "type": "object",
      "required": ["x", "y", "width", "height", "rotation", "rotationX", "rotationY", "perspective", "scaleX", "scaleY", "anchorX", "anchorY"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "rotationX": { "type": "number" },
        "rotationY": { "type": "number" },
        "perspective": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "anchorX": { "type": "number" },
        "anchorY": { "type": "number" }
      }
    },
    "variable": {
      "type": "object",
      "required": ["id", "name", "label", "type", "defaultValue"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "multitext", "textfile", "image", "number", "color", "video", "time"] },
        "defaultValue": { "type": ["string", "number"] },
        "drivenBy": { "type": "string", "minLength": 1 },
        "exposed": { "type": "boolean" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "type": ["string", "number"] },
          "maxItems": 64
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "placeholder": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": { "defaultValue": { "type": "number" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["text", "multitext", "textfile", "image", "color", "video", "time"] } }
          },
          "then": {
            "properties": { "defaultValue": { "type": "string" } }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "required": ["id", "name", "parentId", "visible", "locked", "transform"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "stackEntry": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["layer", "group"] },
        "id": { "type": "string" }
      }
    },
    "textStyle": {
      "type": "object",
      "required": ["fontFamily", "fontSize", "fontWeight", "fill", "align", "lineHeight", "letterSpacing", "strokeColor", "strokeWidth", "dropShadow", "dropShadowBlur", "dropShadowColor", "dropShadowDistance"],
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number" },
        "fontWeight": { "type": "string" },
        "fill": { "$ref": "#/$defs/stringOrBinding" },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "lineHeight": { "type": "number" },
        "letterSpacing": { "type": "number" },
        "strokeColor": { "type": "string" },
        "strokeWidth": { "type": "number" },
        "dropShadow": { "type": "boolean" },
        "dropShadowBlur": { "type": "number" },
        "dropShadowColor": { "type": "string" },
        "dropShadowDistance": { "type": "number" },
        "textTransform": {
          "type": "string",
          "enum": ["none", "uppercase", "titlecase", "lowercase"]
        },
        "dropShadowOffsetX": { "type": "number" },
        "dropShadowOffsetY": { "type": "number" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "type", "visible", "locked", "opacity", "blendMode", "transform", "groupId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "rect", "image", "video", "clock", "mask", "crawl"] },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blendMode": { "$ref": "#/$defs/blendMode" },
        "transform": { "$ref": "#/$defs/transform" },
        "groupId": { "type": ["string", "null"] },
        "content": { "$ref": "#/$defs/stringOrBinding" },
        "style": { "$ref": "#/$defs/textStyle" },
        "fill": { "$ref": "#/$defs/stringOrBinding" },
        "fillMode": { "type": "string", "enum": ["solid", "gradient"] },
        "gradient": { "$ref": "#/$defs/fourCornerGradient" },
        "cornerRadius": { "type": "number" },
        "borderColor": { "type": "string" },
        "borderWidth": { "type": "number" },
        "src": { "$ref": "#/$defs/stringOrBinding" },
        "fit": { "type": "string", "enum": ["stretch", "contain", "cover"] },
        "loop": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["clock", "countup", "countdown"] },
        "format": { "type": "string" },
        "startTime": { "$ref": "#/$defs/numberOrBinding" },
        "targetTime": { "$ref": "#/$defs/numberOrBinding" },
        "maskMode": { "type": "string", "enum": ["normal", "inverted"] },
        "shape": { "type": "string", "enum": ["rect", "ellipse"] },
        "crawlDirectorId": { "type": "string", "minLength": 1 },
        "crawl": { "$ref": "#/$defs/crawlProps" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "required": ["content", "style"],
            "properties": {
              "content": { "$ref": "#/$defs/stringOrBinding" },
              "style": { "$ref": "#/$defs/textStyle" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rect" } } },
          "then": {
            "required": ["fill", "cornerRadius", "borderColor", "borderWidth"],
            "properties": {
              "fill": { "$ref": "#/$defs/stringOrBinding" },
              "cornerRadius": { "type": "number" },
              "borderColor": { "type": "string" },
              "borderWidth": { "type": "number" }
            }
          }
        },
        {
          "if": {
            "required": ["fillMode"],
            "properties": { "fillMode": { "enum": ["solid", "gradient"] } }
          },
          "then": {
            "properties": {
              "type": { "const": "rect" }
            }
          }
        },
        {
          "if": {
            "required": ["fillMode"],
            "properties": { "fillMode": { "const": "gradient" } }
          },
          "then": {
            "required": ["gradient"]
          }
        },
        {
          "if": {
            "required": ["gradient"]
          },
          "then": {
            "required": ["fillMode"],
            "properties": {
              "type": { "const": "rect" },
              "fillMode": { "const": "gradient" }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["crawl"] },
              { "required": ["crawlDirectorId"] }
            ]
          },
          "then": {
            "properties": {
              "type": { "const": "crawl" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": {
            "required": ["src", "cornerRadius", "fit"],
            "properties": {
              "src": { "$ref": "#/$defs/stringOrBinding" },
              "cornerRadius": { "type": "number" },
              "fit": { "type": "string", "enum": ["stretch", "contain", "cover"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "video" } } },
          "then": {
            "required": ["src", "loop", "fit"],
            "properties": {
              "src": { "$ref": "#/$defs/stringOrBinding" },
              "loop": { "type": "boolean" },
              "fit": { "type": "string", "enum": ["stretch", "contain", "cover"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "clock" } } },
          "then": {
            "required": ["mode", "format", "style"],
            "properties": {
              "mode": { "type": "string", "enum": ["clock", "countup", "countdown"] },
              "format": { "type": "string" },
              "startTime": { "type": "number" },
              "targetTime": { "type": "number" },
              "style": { "$ref": "#/$defs/textStyle" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "mask" } } },
          "then": {
            "required": ["maskMode", "shape", "cornerRadius"],
            "properties": {
              "maskMode": { "type": "string", "enum": ["normal", "inverted"] },
              "shape": { "type": "string", "enum": ["rect", "ellipse"] },
              "fill": { "$ref": "#/$defs/stringOrBinding" },
              "cornerRadius": { "type": "number" },
              "borderColor": { "type": "string" },
              "borderWidth": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "crawl" } } },
          "then": {
            "required": ["content", "style", "crawlDirectorId", "crawl"],
            "properties": {
              "content": { "$ref": "#/$defs/stringOrBinding" },
              "style": { "$ref": "#/$defs/textStyle" },
              "crawlDirectorId": { "type": "string", "minLength": 1 },
              "crawl": { "$ref": "#/$defs/crawlProps" }
            }
          }
        }
      ]
    },
    "gradientWeights": {
      "type": "object",
      "required": ["topLeft", "topRight", "bottomLeft", "bottomRight"],
      "additionalProperties": false,
      "properties": {
        "topLeft": { "type": "number", "minimum": 0, "maximum": 100 },
        "topRight": { "type": "number", "minimum": 0, "maximum": 100 },
        "bottomLeft": { "type": "number", "minimum": 0, "maximum": 100 },
        "bottomRight": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "fourCornerGradient": {
      "type": "object",
      "required": ["topLeft", "topRight", "bottomLeft", "bottomRight", "weights"],
      "additionalProperties": false,
      "properties": {
        "topLeft": { "type": "string" },
        "topRight": { "type": "string" },
        "bottomLeft": { "type": "string" },
        "bottomRight": { "type": "string" },
        "weights": { "$ref": "#/$defs/gradientWeights" }
      }
    },
    "crawlProps": {
      "type": "object",
      "required": [
        "type",
        "directionIn",
        "directionOut",
        "speed",
        "pause",
        "separatorMode",
        "separatorText",
        "separatorImage",
        "animationType",
        "useFile",
        "filePath",
        "maxTextLengthEnabled",
        "maxTextLength"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ticker", "carousel"] },
        "directionIn": { "type": "string", "enum": ["left", "right", "up", "down"] },
        "directionOut": { "type": "string", "enum": ["left", "right", "up", "down"] },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "pause": { "type": "number", "minimum": 0 },
        "separatorMode": { "type": "string", "enum": ["none", "text", "image"] },
        "separatorText": { "type": "string" },
        "separatorImage": { "type": "string" },
        "animationType": { "type": "string", "enum": ["batch", "continuous"] },
        "useFile": { "type": "boolean" },
        "filePath": { "type": "string" },
        "maxTextLengthEnabled": { "type": "boolean" },
        "maxTextLength": { "type": "number", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "ticker" } }
          },
          "then": {
            "properties": {
              "directionIn": { "enum": ["left", "right"] },
              "directionOut": { "enum": ["left", "right"] }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "carousel" } }
          },
          "then": {
            "properties": {
              "directionIn": { "enum": ["up", "down"] },
              "directionOut": { "enum": ["up", "down"] }
            }
          }
        }
      ]
    },
    "dataPath": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "literal" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "variableId"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "variable" },
            "variableId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "dataSourceOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoding": { "type": "string", "enum": ["utf-8"] },
        "delimiter": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skipEmpty": { "type": "boolean" },
        "trim": { "type": "boolean" },
        "hasHeader": { "type": "boolean" },
        "commentPrefix": { "type": "string" },
        "kvSeparator": { "type": "string", "minLength": 1 },
        "rootPath": { "type": "string", "minLength": 1 }
      }
    },
    "dataSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "content", "format"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "type": { "const": "inline" },
            "content": { "type": "string" },
            "format": { "type": "string", "enum": ["lines", "delimited", "kv", "json"] },
            "options": { "$ref": "#/$defs/dataSourceOptions" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "path", "format"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "type": { "type": "string", "enum": ["textfile", "jsonfile"] },
            "path": { "$ref": "#/$defs/dataPath" },
            "format": { "type": "string", "enum": ["lines", "delimited", "kv", "json"] },
            "options": { "$ref": "#/$defs/dataSourceOptions" }
          }
        }
      ]
    },
    "dataSelect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["first", "last", "all"] }
          }
        },
        {
          "type": "object",
          "required": ["mode", "index"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "index" },
            "index": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["mode", "key", "value"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "byKey" },
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["mode", "key", "pattern"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "match" },
            "key": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string" }
          }
        }
      ]
    },
    "dataMapTarget": {
      "type": "object",
      "required": ["type", "variableId"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "variable" },
        "variableId": { "type": "string", "minLength": 1 }
      }
    },
    "dataMapTransform": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "trim" }
          }
        },
        {
          "type": "object",
          "required": ["op", "value"],
          "additionalProperties": false,
          "properties": {
            "op": { "type": "string", "enum": ["prefix", "suffix"] },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "pattern", "replacement"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "replace" },
            "pattern": { "type": "string" },
            "replacement": { "type": "string" },
            "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" }
          }
        }
      ]
    },
    "dataMap": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "$ref": "#/$defs/dataMapTarget" },
        "as": {
          "type": "string",
          "enum": ["text", "multitext", "number", "time", "image", "video"]
        },
        "transform": { "$ref": "#/$defs/dataMapTransform" }
      }
    },
    "dataJoin": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "separator": { "type": "string" }
      }
    },
    "dataMediaResolve": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "array",
          "items": { "type": "string", "enum": ["assetId", "url", "path"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "onMiss": { "type": "string", "enum": ["block", "keep", "clear"] },
        "fallbackUrl": { "type": "string" }
      }
    },
    "dataPipeline": {
      "type": "object",
      "required": ["id", "sourceId", "select", "map"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "select": { "$ref": "#/$defs/dataSelect" },
        "map": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataMap" },
          "minItems": 1
        },
        "join": { "$ref": "#/$defs/dataJoin" },
        "mediaResolve": { "$ref": "#/$defs/dataMediaResolve" },
        "onEmpty": { "type": "string", "enum": ["block", "keep", "clear"] }
      }
    },
    "templateData": {
      "type": "object",
      "required": ["version", "sources", "pipelines"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataSource" }
        },
        "pipelines": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataPipeline" }
        },
        "runOn": {
          "type": "array",
          "items": { "type": "string", "enum": ["take", "load", "update", "refresh"] },
          "uniqueItems": true
        },
        "onError": { "type": "string", "enum": ["block", "keep", "clear"] }
      }
    },
    "bezier": {
      "type": "object",
      "required": ["cp1x", "cp1y", "cp2x", "cp2y"],
      "additionalProperties": false,
      "properties": {
        "cp1x": { "type": "number" },
        "cp1y": { "type": "number" },
        "cp2x": { "type": "number" },
        "cp2y": { "type": "number" }
      }
    },
    "keyframe": {
      "type": "object",
      "required": ["id", "frame", "layers", "groups", "easing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "frame": { "type": "integer", "minimum": 0 },
        "layers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/animatableValues" }
        },
        "groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/animatableValues" }
        },
        "easing": { "$ref": "#/$defs/easingType" },
        "bezier": { "$ref": "#/$defs/bezier" }
      }
    },
    "animatableValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "rotationX": { "type": "number" },
        "rotationY": { "type": "number" },
        "perspective": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "opacity": { "type": "number" },
        "crawlProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "gradient.weights.topLeft": { "type": "number", "minimum": 0, "maximum": 100 },
        "gradient.weights.topRight": { "type": "number", "minimum": 0, "maximum": 100 },
        "gradient.weights.bottomLeft": { "type": "number", "minimum": 0, "maximum": 100 },
        "gradient.weights.bottomRight": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "director": {
      "type": "object",
      "required": ["id", "name", "durationFrames", "offsetFrames", "autostart", "loop", "swing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "offsetFrames": { "type": "integer", "minimum": 0 },
        "autostart": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "swing": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "directorId", "frame", "command"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "directorId": { "type": "string" },
        "frame": { "type": "integer", "minimum": 0 },
        "command": { "type": "string", "enum": ["startDirector", "stopDirector", "setTag"] },
        "targetDirectorId": { "type": ["string", "null"] },
        "tag": { "type": ["string", "null"], "enum": ["Stop", "End scene", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "command": { "enum": ["startDirector", "stopDirector"] } } },
          "then": {
            "required": ["targetDirectorId"],
            "properties": {
              "targetDirectorId": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "command": { "const": "setTag" } } },
          "then": {
            "required": ["tag"]
          }
        }
      ]
    },
    "cueItem": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "command", "parameterDirectorId", "lengthFrames", "direction"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "command": {
              "type": "string",
              "enum": ["startDirector", "pauseDirector", "stopDirector", "stopDirectorAndWaitContinue"]
            },
            "parameterDirectorId": { "type": "string", "minLength": 1 },
            "lengthFrames": { "type": "integer", "minimum": 0 },
            "direction": { "type": "string", "enum": ["normal", "reverse", "both"] }
          }
        },
        {
          "type": "object",
          "required": ["id", "command", "parameterTag", "lengthFrames", "direction"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "command": { "const": "tag" },
            "parameterTag": { "type": "string", "enum": ["updateData", "endScene"] },
            "lengthFrames": { "type": "integer", "minimum": 0 },
            "direction": { "type": "string", "enum": ["normal", "reverse", "both"] }
          }
        }
      ]
    },
    "cue": {
      "type": "object",
      "required": ["id", "directorId", "frame", "fromEnd", "name", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "directorId": { "type": "string", "minLength": 1 },
        "frame": { "type": "integer", "minimum": 0 },
        "fromEnd": { "type": "boolean" },
        "name": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/cueItem" },
          "minItems": 1
        }
      }
    },
    "propertyTrackDirectorAssignments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "z": { "type": "string", "minLength": 1 },
        "width": { "type": "string", "minLength": 1 },
        "height": { "type": "string", "minLength": 1 },
        "rotation": { "type": "string", "minLength": 1 },
        "rotationX": { "type": "string", "minLength": 1 },
        "rotationY": { "type": "string", "minLength": 1 },
        "perspective": { "type": "string", "minLength": 1 },
        "scaleX": { "type": "string", "minLength": 1 },
        "scaleY": { "type": "string", "minLength": 1 },
        "opacity": { "type": "string", "minLength": 1 },
        "crawlProgress": { "type": "string", "minLength": 1 },
        "gradient.weights.topLeft": { "type": "string", "minLength": 1 },
        "gradient.weights.topRight": { "type": "string", "minLength": 1 },
        "gradient.weights.bottomLeft": { "type": "string", "minLength": 1 },
        "gradient.weights.bottomRight": { "type": "string", "minLength": 1 }
      }
    },
    "propertyTrackDirectors": {
      "type": "object",
      "patternProperties": {
        "^.+$": { "$ref": "#/$defs/propertyTrackDirectorAssignments" }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["fps", "durationFrames", "playbackMode", "directors", "trackDirectors", "keyframes", "actions"],
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "integer", "minimum": 1 },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "playbackMode": { "type": "string", "enum": ["bounded", "infinite"] },
        "directors": { "type": "array", "items": { "$ref": "#/$defs/director" } },
        "trackDirectors": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" } },
        "propertyTrackDirectors": { "$ref": "#/$defs/propertyTrackDirectors" }
      }
    }
  }
}
