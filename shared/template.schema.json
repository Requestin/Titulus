{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://titulus/titulus/template.schema.json",
  "title": "Titulus Template",
  "description": "Canonical template domain model (DEVELOPMENT_PROMPT §6.2). Validated by backend /api/templates/validate (ajv). AI-friendly: a conforming JSON renders deterministically through runtime/domRenderer.",
  "type": "object",
  "required": ["id", "name", "canvas", "variables", "groups", "layers", "rootStack", "groupStacks", "timeline"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Template schema version for migrations (e.g. 1.0.0).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": { "type": "string", "description": "UUID" },
    "name": { "type": "string" },
    "description": {
      "type": "string",
      "description": "Human-readable intent; useful for operators and AI generation."
    },
    "tags": {
      "type": "array",
      "description": "Search/generation tags (e.g. lower-third, election, breaking).",
      "items": { "type": "string" },
      "maxItems": 32
    },
    "metadata": { "$ref": "#/$defs/templateMetadata" },
    "layerId": {
      "type": "integer",
      "description": "Cross-template playout stack rank on a channel (1–99). Smaller draws above. Default 50. Same layerId TAKE clears the previous occupant.",
      "minimum": 1,
      "maximum": 99,
      "default": 50
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "description": "'transparent' or a CSS color" }
      }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" }
    },
    "rootStack": {
      "type": "array",
      "description": "Top-level z-order; last entry = frontmost.",
      "items": { "$ref": "#/$defs/stackEntry" }
    },
    "groupStacks": {
      "type": "object",
      "description": "Per-group child ordering (groupId -> entries).",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/stackEntry" }
      }
    },
    "timeline": { "$ref": "#/$defs/timeline" },
    "data": { "$ref": "#/$defs/templateData" }
  },

  "$defs": {
    "templateMetadata": {
      "type": "object",
      "description": "Optional AI/operator hints. Runtime may ignore these fields.",
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string" },
        "locale": { "type": "string", "description": "BCP-47 locale, e.g. en-US" },
        "safeTitle": { "type": "string", "description": "One-line title for generated catalogs." },
        "notes": { "type": "string" }
      }
    },
    "templateData": {
      "type": "object",
      "required": ["version", "sources", "pipelines"],
      "additionalProperties": false,
      "description": "Designer-owned file→variable pipeline. Control does not pick rows.",
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataSource" },
          "maxItems": 16
        },
        "pipelines": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataPipeline" },
          "maxItems": 16
        },
        "runOn": {
          "type": "array",
          "items": { "type": "string", "enum": ["take", "update", "load", "refresh"] },
          "uniqueItems": true,
          "minItems": 1
        },
        "onError": { "type": "string", "enum": ["block", "keep", "clear"] }
      }
    },
    "dataPathRef": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "literal" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "variableId"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "variable" },
            "variableId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "dataSourceOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoding": { "type": "string", "enum": ["utf-8"] },
        "skipEmpty": { "type": "boolean" },
        "trim": { "type": "boolean" },
        "commentPrefix": { "type": "string" },
        "delimiter": { "type": "string", "minLength": 1 },
        "hasHeader": { "type": "boolean" },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 64
        },
        "kvSeparator": { "type": "string", "minLength": 1 },
        "rootPath": { "type": "string" }
      }
    },
    "dataSource": {
      "type": "object",
      "required": ["id", "type", "format"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["textfile", "jsonfile", "inline"] },
        "path": { "$ref": "#/$defs/dataPathRef" },
        "content": { "type": "string" },
        "format": { "type": "string", "enum": ["lines", "delimited", "kv", "json"] },
        "options": { "$ref": "#/$defs/dataSourceOptions" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["textfile", "jsonfile"] } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "type": { "const": "inline" } } },
          "then": { "required": ["content"] }
        },
        {
          "if": { "properties": { "type": { "const": "jsonfile" } } },
          "then": { "properties": { "format": { "const": "json" } } }
        }
      ]
    },
    "dataSelect": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["first", "last", "index", "byKey", "match", "all"] },
        "index": { "type": "integer", "minimum": 1 },
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "pattern": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "index" } } },
          "then": { "required": ["index"] }
        },
        {
          "if": { "properties": { "mode": { "const": "byKey" } } },
          "then": { "required": ["key", "value"] }
        },
        {
          "if": { "properties": { "mode": { "const": "match" } } },
          "then": { "required": ["key", "pattern"] }
        }
      ]
    },
    "dataMapTarget": {
      "type": "object",
      "required": ["type", "variableId"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "variable" },
        "variableId": { "type": "string", "minLength": 1 }
      }
    },
    "dataValueTransform": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "enum": ["trim", "prefix", "suffix", "replace"] },
        "value": { "type": "string" },
        "pattern": { "type": "string" },
        "replacement": { "type": "string" },
        "flags": { "type": "string" }
      }
    },
    "dataMapEntry": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "$ref": "#/$defs/dataMapTarget" },
        "as": { "type": "string", "enum": ["text", "number", "image", "video", "multitext", "time"] },
        "transform": { "$ref": "#/$defs/dataValueTransform" }
      }
    },
    "mediaResolvePolicy": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "array",
          "items": { "type": "string", "enum": ["assetId", "url", "path"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "onMiss": { "type": "string", "enum": ["keep", "clear", "block"] },
        "fallbackUrl": { "type": "string" }
      }
    },
    "dataPipeline": {
      "type": "object",
      "required": ["id", "sourceId", "select", "map"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "select": { "$ref": "#/$defs/dataSelect" },
        "map": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataMapEntry" },
          "minItems": 0,
          "maxItems": 64
        },
        "join": {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "separator": { "type": "string" }
          }
        },
        "mediaResolve": { "$ref": "#/$defs/mediaResolvePolicy" },
        "onEmpty": { "type": "string", "enum": ["keep", "clear", "block"] }
      }
    },
    "blendMode": {
      "type": "string",
      "enum": ["normal", "multiply", "screen", "add", "overlay", "darken", "lighten"]
    },
    "easingType": {
      "type": "string",
      "enum": ["linear", "power2.in", "power2.out", "power2.inOut", "bounce.out", "elastic.out"]
    },
    "variableBinding": {
      "type": "object",
      "required": ["type", "variableId"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "variable" },
        "variableId": { "type": "string" }
      }
    },
    "stringOrBinding": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/variableBinding" }
      ]
    },
    "numberOrBinding": {
      "oneOf": [
        { "type": "number" },
        { "$ref": "#/$defs/variableBinding" }
      ]
    },
    "transform": {
      "type": "object",
      "required": ["x", "y", "width", "height", "rotation", "rotationX", "rotationY", "perspective", "scaleX", "scaleY", "anchorX", "anchorY"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number", "description": "CSS translateZ in px (2.5D depth). Optional for legacy templates; default 0." },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "rotationX": { "type": "number" },
        "rotationY": { "type": "number" },
        "perspective": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "anchorX": { "type": "number" },
        "anchorY": { "type": "number" }
      }
    },
    "variable": {
      "type": "object",
      "required": ["id", "name", "label", "type", "defaultValue"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "number", "color", "video", "multitext", "textfile", "time"] },
        "defaultValue": { "type": ["string", "number"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "type": ["string", "number"] },
          "maxItems": 64
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "placeholder": { "type": "string" },
        "drivenBy": {
          "type": "string",
          "description": "Pipeline id that owns this variable (template.data.pipelines[].id)."
        },
        "exposed": {
          "type": "boolean",
          "description": "If false, never show in Control. Driven vars default hidden unless true."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": { "defaultValue": { "type": "number" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["text", "image", "color", "video", "multitext", "textfile", "time"] } }
          },
          "then": {
            "properties": { "defaultValue": { "type": "string" } }
          }
        }
      ]
    },
    "rectGradientCorner": {
      "type": "object",
      "required": ["color", "value"],
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string" },
        "value": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "rectGradient": {
      "type": "object",
      "required": ["upperLeft", "lowerLeft", "upperRight", "lowerRight"],
      "additionalProperties": false,
      "properties": {
        "upperLeft": { "$ref": "#/$defs/rectGradientCorner" },
        "lowerLeft": { "$ref": "#/$defs/rectGradientCorner" },
        "upperRight": { "$ref": "#/$defs/rectGradientCorner" },
        "lowerRight": { "$ref": "#/$defs/rectGradientCorner" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "name", "parentId", "visible", "locked", "transform"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "stackEntry": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["layer", "group"] },
        "id": { "type": "string" }
      }
    },
    "textStyle": {
      "type": "object",
      "required": ["fontFamily", "fontSize", "fontWeight", "fill", "align", "lineHeight", "letterSpacing", "strokeColor", "strokeWidth", "dropShadow", "dropShadowBlur", "dropShadowColor"],
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number" },
        "fontWeight": { "type": "string" },
        "fill": { "$ref": "#/$defs/stringOrBinding" },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "lineHeight": { "type": "number" },
        "letterSpacing": { "type": "number" },
        "strokeColor": { "type": "string" },
        "strokeWidth": { "type": "number" },
        "textTransform": { "type": "string", "enum": ["none", "uppercase", "titlecase", "lowercase"] },
        "dropShadow": { "type": "boolean" },
        "dropShadowBlur": { "type": "number" },
        "dropShadowColor": { "type": "string" },
        "dropShadowOffsetX": { "type": "number" },
        "dropShadowOffsetY": { "type": "number" },
        "dropShadowDistance": { "type": "number", "description": "Deprecated: legacy Y offset; prefer dropShadowOffsetX/Y" }
      }
    },
    "crawlProps": {
      "type": "object",
      "required": [
        "type", "directionIn", "directionOut", "speed", "pause",
        "separatorMode", "separatorText", "separatorImage", "animationType",
        "useFile", "filePath", "maxTextLengthEnabled", "maxTextLength"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ticker", "carousel"] },
        "directionIn": { "type": "string", "enum": ["left", "right", "up", "down"] },
        "directionOut": { "type": "string", "enum": ["left", "right", "up", "down"] },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "pause": { "type": "number", "minimum": 0, "description": "Hold duration in frames when a line is fully on screen" },
        "separatorMode": { "type": "string", "enum": ["none", "text", "image"] },
        "separatorText": { "type": "string" },
        "separatorImage": { "type": "string" },
        "animationType": { "type": "string", "enum": ["batch", "continuous"] },
        "useFile": { "type": "boolean" },
        "filePath": { "type": "string" },
        "maxTextLengthEnabled": { "type": "boolean" },
        "maxTextLength": { "type": "number", "minimum": 1 }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "type", "visible", "locked", "opacity", "blendMode", "transform", "groupId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "rect", "image", "video", "clock", "mask", "crawl"] },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blendMode": { "$ref": "#/$defs/blendMode" },
        "transform": { "$ref": "#/$defs/transform" },
        "groupId": { "type": ["string", "null"] },
        "content": { "$ref": "#/$defs/stringOrBinding" },
        "style": { "$ref": "#/$defs/textStyle" },
        "fill": { "$ref": "#/$defs/stringOrBinding" },
        "cornerRadius": { "type": "number" },
        "borderColor": { "type": "string" },
        "borderWidth": { "type": "number" },
        "src": { "$ref": "#/$defs/stringOrBinding" },
        "fit": { "type": "string", "enum": ["stretch", "contain", "cover"] },
        "loop": { "type": "boolean" },
        "endBehavior": { "type": "string", "enum": ["lastFrame", "empty"] },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string", "enum": ["clock", "countup", "countdown"] },
        "format": { "type": "string" },
        "startTime": { "$ref": "#/$defs/numberOrBinding" },
        "targetTime": { "$ref": "#/$defs/numberOrBinding" },
        "maskMode": { "type": "string", "enum": ["normal", "inverted"] },
        "shape": { "type": "string", "enum": ["rect", "ellipse"] },
        "crawlDirectorId": { "type": "string" },
        "crawl": { "$ref": "#/$defs/crawlProps" },
        "fillMode": { "type": "string", "enum": ["solid", "gradient"] },
        "gradient": { "$ref": "#/$defs/rectGradient" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "required": ["content", "style"],
            "properties": {
              "content": { "$ref": "#/$defs/stringOrBinding" },
              "style": { "$ref": "#/$defs/textStyle" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rect" } } },
          "then": {
            "required": ["fill", "cornerRadius", "borderColor", "borderWidth"],
            "properties": {
              "fill": { "$ref": "#/$defs/stringOrBinding" },
              "fillMode": { "type": "string", "enum": ["solid", "gradient"] },
              "gradient": { "$ref": "#/$defs/rectGradient" },
              "cornerRadius": { "type": "number" },
              "borderColor": { "type": "string" },
              "borderWidth": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": {
            "required": ["src", "cornerRadius", "fit"],
            "properties": {
              "src": { "$ref": "#/$defs/stringOrBinding" },
              "cornerRadius": { "type": "number" },
              "fit": { "type": "string", "enum": ["stretch", "contain", "cover"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "video" } } },
          "then": {
            "required": ["src", "loop", "fit"],
            "properties": {
              "src": { "$ref": "#/$defs/stringOrBinding" },
              "loop": { "type": "boolean" },
              "fit": { "type": "string", "enum": ["stretch", "contain", "cover"] },
              "endBehavior": { "type": "string", "enum": ["lastFrame", "empty"] },
              "durationFrames": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "clock" } } },
          "then": {
            "required": ["mode", "format", "style"],
            "properties": {
              "mode": { "type": "string", "enum": ["clock", "countup", "countdown"] },
              "format": { "type": "string" },
              "startTime": { "$ref": "#/$defs/numberOrBinding" },
              "targetTime": { "$ref": "#/$defs/numberOrBinding" },
              "style": { "$ref": "#/$defs/textStyle" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "mask" } } },
          "then": {
            "required": ["maskMode", "shape", "cornerRadius"],
            "properties": {
              "maskMode": { "type": "string", "enum": ["normal", "inverted"] },
              "shape": { "type": "string", "enum": ["rect", "ellipse"] },
              "fill": { "$ref": "#/$defs/stringOrBinding" },
              "cornerRadius": { "type": "number" },
              "borderColor": { "type": "string" },
              "borderWidth": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "crawl" } } },
          "then": {
            "required": ["content", "style", "crawlDirectorId", "crawl"],
            "properties": {
              "content": { "$ref": "#/$defs/stringOrBinding" },
              "style": { "$ref": "#/$defs/textStyle" },
              "crawlDirectorId": { "type": "string" },
              "crawl": { "$ref": "#/$defs/crawlProps" }
            }
          }
        }
      ]
    },
    "bezier": {
      "type": "object",
      "required": ["cp1x", "cp1y", "cp2x", "cp2y"],
      "additionalProperties": false,
      "properties": {
        "cp1x": { "type": "number" },
        "cp1y": { "type": "number" },
        "cp2x": { "type": "number" },
        "cp2y": { "type": "number" }
      }
    },
    "keyframe": {
      "type": "object",
      "required": ["id", "frame", "layers", "groups", "easing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "frame": { "type": "integer", "minimum": 0 },
        "layers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/animatableValues" }
        },
        "groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/animatableValues" }
        },
        "easing": { "$ref": "#/$defs/easingType" },
        "bezier": { "$ref": "#/$defs/bezier" }
      }
    },
    "animatableValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "rotationX": { "type": "number" },
        "rotationY": { "type": "number" },
        "perspective": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "opacity": { "type": "number" },
        "crawlProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "videoProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "UpperLeft": { "type": "number", "minimum": 0, "maximum": 100 },
        "LowerLeft": { "type": "number", "minimum": 0, "maximum": 100 },
        "UpperRight": { "type": "number", "minimum": 0, "maximum": 100 },
        "LowerRight": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "director": {
      "type": "object",
      "required": ["id", "name", "durationFrames", "offsetFrames", "autostart", "loop", "swing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "offsetFrames": { "type": "integer", "minimum": 0 },
        "autostart": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "swing": { "type": "boolean" }
      }
    },
    "actionItem": {
      "type": "object",
      "required": ["id", "command", "lengthFrames", "direction"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "command": {
          "type": ["string", "null"],
          "enum": [
            "startDirector",
            "stopDirector",
            "stopDirectorAndWaitContinue",
            "pauseDirector",
            "tag",
            null
          ]
        },
        "parameterDirectorId": { "type": ["string", "null"] },
        "parameterTag": {
          "type": ["string", "null"],
          "enum": ["endScene", "updateData", null]
        },
        "lengthFrames": { "type": "integer", "minimum": 0 },
        "direction": { "type": "string", "enum": ["both", "normal", "reverse"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "startDirector",
                  "stopDirector",
                  "stopDirectorAndWaitContinue",
                  "pauseDirector"
                ]
              }
            }
          },
          "then": {
            "required": ["parameterDirectorId"],
            "properties": {
              "parameterDirectorId": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "command": { "const": "tag" } } },
          "then": {
            "required": ["parameterTag"],
            "properties": {
              "parameterTag": { "type": "string", "enum": ["endScene", "updateData"] }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["id", "directorId", "frame", "name", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "directorId": { "type": "string", "minLength": 1 },
        "frame": { "type": "integer", "minimum": 0 },
        "fromEnd": {
          "type": "boolean",
          "description": "If true, frame is an offset from the director end (fires at durationFrames - frame)"
        },
        "name": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/actionItem" }
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["fps", "durationFrames", "playbackMode", "directors", "trackDirectors", "keyframes", "actions"],
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "integer", "minimum": 1 },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "playbackMode": { "type": "string", "enum": ["bounded", "infinite"] },
        "directors": { "type": "array", "items": { "$ref": "#/$defs/director" } },
        "trackDirectors": {
          "type": "object",
          "description": "Animated track key (layer:<id>:<prop> or group:<id>:<prop>, legacy: bare target id) -> director id",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "trackOrder": {
          "type": "object",
          "description": "Optional display order of track keys per director",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "keyframes": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    }
  }
}
